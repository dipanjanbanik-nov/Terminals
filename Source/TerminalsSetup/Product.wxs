<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--to make new release change all product id, package id and version number-->
  <Package Name="Terminals" Language="1033" Version="5.0.0.0" Manufacturer="Robert Chartier" UpgradeCode="DD0D31A2-2E86-4F3F-98CE-6AED37FF24CD" InstallerVersion="200">
    
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of Terminals is already installed." />
    
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="INSTALLTYPE" Secure="yes" Value="1"></Property>
    <Icon Id="TerminalsSetupIcon" SourceFile="..\Terminals\terminalsicon.ico" />
    <Property Id="ARPPRODUCTICON" Value="TerminalsSetupIcon" />

    <WixVariable Id="WixUIBannerBmp" Value="WixUIBannerBmp.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="WixUIDialogBmp.bmp" />
    <UIRef Id="WixUI_InstallDirCustom" />

    <Media Id="1" Cabinet="TerminalsInstall.cab" EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="Terminals" Level="1">
      <ComponentGroupRef Id="MainComponents" />
      <ComponentGroupRef Id="IcaComponents" />
      <ComponentGroupRef Id="RdpComponents" />
      <ComponentGroupRef Id="VmrcComponents" />
      <ComponentGroupRef Id="VncComponents" />
      <ComponentGroupRef Id="WebComponents" />
      <ComponentGroupRef Id="PuttyComponents" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <CustomAction Id="FinalizeCustomActionSetProperty" Return="check" Property="FinalizeCustomAction" Value="LOCATION=[INSTALLFOLDER];TYPE=[INSTALLTYPE];" />
    <!-- The custom action updates the installed files, eg. it needs elevated priviledges -->
    <Binary Id="CustomSetupAction.CA.dll" SourceFile="$(var.CustomSetupAction.TargetPath)" />
    <CustomAction Id="FinalizeCustomAction" Return="check" Execute="commit" Impersonate="no" DllEntry="UpgradeConfigFiles" BinaryRef="CustomSetupAction.CA.dll" />
    <InstallExecuteSequence>
      <Custom Action="FinalizeCustomActionSetProperty" Before="InstallFiles" Condition="NOT Installed" />
      <Custom Action="FinalizeCustomAction" After="FinalizeCustomActionSetProperty" Condition="NOT Installed" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
      <StandardDirectory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="Terminals">
          <Directory Id="PLUGINSFOLDER" Name="Plugins">
            <Directory Id="ICAFOLDER" Name="Ica" />
            <Directory Id="RDPFOLDER" Name="Rdp" />
            <Directory Id="PUTTYFOLDER" Name="Putty">
              <Directory Id="PUTTYRESOURCESFOLDER" Name="Resources" />
            </Directory>    
            <Directory Id="VMRCFOLDER" Name="Vmrc" />
            <Directory Id="VNCFOLDER" Name="Vnc" />
            <Directory Id="WEBFOLDER" Name="Web" />
          </Directory>
        </Directory>
      </StandardDirectory>
      <StandardDirectory Id="ProgramMenuFolder">
        <Directory Id="TerminalsProgramsFolder" Name="Terminals" />
      </StandardDirectory>
    </Fragment>

  <Fragment>
    <DirectoryRef Id="TerminalsProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="42B36D8B-C5D6-493C-A794-D158800D9229">
        <Shortcut Id="ApplicationStartMenuShortcut" Name="Terminals" Description="Terminals is a secure, multi tab terminal services/remote desktop client." Target="[INSTALLFOLDER]Terminals.exe" WorkingDirectory="INSTALLFOLDER">
          <Icon Id="terminalsicon.ico" SourceFile="..\Terminals\terminalsicon.ico" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\Robert Chartier\Terminals" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="TerminalsProgramsFolder" On="uninstall" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>